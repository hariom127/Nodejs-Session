# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# Same database as the post service.
MONGO_URI=mongodb://127.0.0.1:27017/blog

REDIS_URL=redis://127.0.0.1:6379

# MUST be identical in the post service. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=blog-auth-service
JWT_AUDIENCE=blog-api

BCRYPT_SALT_ROUNDS=12

# Failed login attempts allowed per IP + email within the window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
